<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>EasyFileTransfer</RootNamespace>
    <AssemblyName>EasyFileTransfer</AssemblyName>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet package metadata (replaces the old .nuspec) -->
  <PropertyGroup>
    <PackageId>EasyFileTransfer</PackageId>
    <Version>0.2.0-preview.2</Version>
    <Title>EasyFileTransfer</Title>
    <Description>An easy way to transfer files of any size over a network using the TCP protocol.</Description>
    <PackageTags>tcp;sockets;file-transfer;networking;large-files</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Jamalianpour/EasyFileTransfer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Security rewrite: new versioned wire protocol with file-name validation (fixes path traversal), bounded reads, timeouts, connection limits, optional access-token authentication and TLS, and SHA-256 integrity checks. New async API (EftClient.SendFileAsync, EftServer.Start/StopAsync); the 0.1.x API remains as [Obsolete] wrappers. Not wire-compatible with 0.1.x.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyFileTransfer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../Screenshots/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
